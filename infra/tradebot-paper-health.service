# TEMPLATE ONLY: an independent timer checks observer freshness and functional health.
[Unit]
Description=TradeBot paper observer freshness and operator health
After=docker.service

[Service]
Type=oneshot
User=tradebot
Group=tradebot
SupplementaryGroups=docker
WorkingDirectory=/opt/tradebot-ai
ExecStart=/usr/bin/python3 /opt/tradebot-ai/scripts/paper_monitor.py health --exchange okx
TimeoutStartSec=10
StandardOutput=journal
StandardError=journal
