# TEMPLATE ONLY: host observer independent from the paper container. Not installed.
[Unit]
Description=TradeBot OKX prospective local observer
Requires=docker.service tradebot-okx-paper.service
After=docker.service tradebot-okx-paper.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=tradebot
Group=tradebot
SupplementaryGroups=docker
WorkingDirectory=/opt/tradebot-ai
ExecStart=/usr/bin/python3 /opt/tradebot-ai/scripts/paper_host.py run-observer --exchange okx
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
