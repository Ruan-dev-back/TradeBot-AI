{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "AgentTrader-V1",
  "dry_run": true,
  "dry_run_wallet": 100,
  "initial_state": "running",
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 10,
  "tradable_balance_ratio": 0.9,
  "fiat_display_currency": "",
  "cancel_open_orders_on_exit": true,
  "db_url": "sqlite:////freqtrade/user_data/agenttrader-v1/trades.sqlite",
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "timeout": 15000,
      "requests_trust_env": true,
      "options": {
        "defaultType": "spot",
        "fetchMarkets": {
          "types": [
            "spot"
          ]
        }
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "timeout": 15000,
      "aiohttp_trust_env": true,
      "options": {
        "defaultType": "spot",
        "fetchMarkets": {
          "types": [
            "spot"
          ]
        }
      }
    },
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": [],
    "enable_ws": false,
    "password": ""
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  },
  "fee": 0.001,
  "logfile": "/freqtrade/user_data/agenttrader-v1/freqtrade.log",
  "strategy": "AgentTraderV1",
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": []
  }
}
