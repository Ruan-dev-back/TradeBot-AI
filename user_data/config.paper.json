{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "tradebot-ai-paper",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "initial_state": "running",
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.9,
  "fiat_display_currency": "USD",
  "cancel_open_orders_on_exit": true,
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.paper.sqlite",
  "timeframe": "1h",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": false
  },
  "telegram": {
    "enabled": false
  },
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
